{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.8.2",
  "description": "__MSG_extDesc__",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "action": {
    "default_title": "__MSG_extShort__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false,
      "js": [
        "src/main/tap.js"
      ]
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false,
      "js": [
        "src/shared/i18n.js",
        "src/shared/defaults.js",
        "src/content/protocol.js",
        "src/content/config.js",
        "src/content/oai.js",
        "src/content/store.js",
        "src/content/chats.js",
        "src/content/conversation.js",
        "src/content/convops.js",
        "src/content/markdown.js",
        "src/content/image.js",
        "src/content/renderplan.js",
        "src/content/theme.js",
        "src/content/shell/cover.js",
        "src/content/shell/clipboard.js",
        "src/content/shell/skin.js",
        "src/content/skins/terminal.js",
        "src/content/skins/sheet.js",
        "src/content/skins/none.js",
        "src/content/palette.js",
        "src/content/sidebar.js",
        "src/content/compose.js",
        "src/content/picker.js",
        "src/content/navigate.js",
        "src/content/commands.js",
        "src/content/health.js",
        "src/content/shell/prompt.js",
        "src/content/index.js"
      ]
    }
  ],
  "default_locale": "ko"
}
